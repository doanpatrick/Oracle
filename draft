2.1. (Optionnel) Nettoyer une ancienne ACL si tu repars de zéro

Si tu avais déjà smtps_acl_kpam_export.xml ou autre ACL pour ce host/port
et que tu veux tout remettre propre :

BEGIN
  DBMS_NETWORK_ACL_ADMIN.UNASSIGN_ACL(
    host       => 'SMTP_HOST',
    lower_port => 587
  );
EXCEPTION
  WHEN OTHERS THEN
    NULL; -- si rien n'était assigné, on ignore
END;
/


BEGIN
  DBMS_NETWORK_ACL_ADMIN.DROP_ACL(
    acl => 'smtps_acl_587.xml'
  );
EXCEPTION
  WHEN OTHERS THEN
    NULL; -- si elle n'existait pas, on ignore
END;
/


2.2. Créer UNE ACL avec PERFRISK

BEGIN
  DBMS_NETWORK_ACL_ADMIN.CREATE_ACL(
    acl         => 'smtps_acl_587.xml',
    description => 'ACL SMTP 587 pour PERFRISK et KPAM_EXPORT',
    principal   => 'PERFRISK',    -- 🔹 premier user
    is_grant    => TRUE,
    privilege   => 'connect'
  );
END;
/


Autoriser aussi la résolution DNS :

BEGIN
  DBMS_NETWORK_ACL_ADMIN.ADD_PRIVILEGE(
    acl       => 'smtps_acl_587.xml',
    principal => 'PERFRISK',
    is_grant  => TRUE,
    privilege => 'resolve'
  );
END;
/

2.3. Ajouter KPAM_EXPORT dans la même ACL

BEGIN
  DBMS_NETWORK_ACL_ADMIN.ADD_PRIVILEGE(
    acl       => 'smtps_acl_587.xml',
    principal => 'KPAM_EXPORT',   -- 🔹 deuxième user
    is_grant  => TRUE,
    privilege => 'connect'
  );
END;
/

BEGIN
  DBMS_NETWORK_ACL_ADMIN.ADD_PRIVILEGE(
    acl       => 'smtps_acl_587.xml',
    principal => 'KPAM_EXPORT',
    is_grant  => TRUE,
    privilege => 'resolve'
  );
END;
/

2.4. Assigner l’ACL au serveur SMTP / port 587

BEGIN
  DBMS_NETWORK_ACL_ADMIN.ASSIGN_ACL(
    acl        => 'smtps_acl_587.xml',
    host       => 'SMTP_HOST',    -- ex : 'smtp.mon-domaine.fr'
    lower_port => 587,
    upper_port => 587
  );
END;
/

2.5. Vérification


SELECT acl, host, lower_port, upper_port
FROM dba_network_acls
WHERE host = 'SMTP_HOST';

SELECT acl, principal, privilege, is_grant
FROM dba_network_acl_privileges
WHERE acl = 'smtps_acl_587.xml'
ORDER BY principal, privilege;







